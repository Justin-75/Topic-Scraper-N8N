# Optional settings for docker-compose.yml. Most people do not need this file.
# To use it: copy it to ".env" in the same folder and remove the "#" from the lines you want.
#
# No API keys go here. Keys are entered in the n8n editor (Credentials).

# If Docker Hub or PyPI is slow or blocked on your network, point at mirrors, for example:
# N8N_IMAGE=docker.m.daocloud.io/n8nio/n8n
# PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
# PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple

# To stay on the n8n version this workflow was tested with:
# N8N_IMAGE=docker.n8n.io/n8nio/n8n:2.42.6
